{
"$schema": "https://json-schema.org/draft/2020-12/schema",
"title": "Candidate Finding",
"type": "object",
"required": [
"finding_id",
"review_id",
"agent",
"title",
"category",
"severity",
"file",
"start_line",
"description"
],
"properties": {
"finding_id": {
"type": "string"
},
"review_id": {
"type": "string"
},
"agent": {
"type": "string",
"enum": [
"security_review",
"owasp_cwe",
"crypto",
"auth"
]
},
"title": {
"type": "string"
},
"category": {
"type": "string",
"enum": [
"sql_injection",
"command_injection",
"hardcoded_secret",
"weak_cryptography",
"authentication_authorization"
]
},
"cwe": {
"type": ["string", "null"]
},
"severity": {
"type": "string",
"enum": [
"CRITICAL",
"HIGH",
"MEDIUM",
"LOW"
]
},
"file": {
"type": "string"
},
"start_line": {
"type": "integer",
"minimum": 1
},
"end_line": {
"type": "integer",
"minimum": 1
},
"function": {
"type": ["string", "null"]
},
"description": {
"type": "string"
},
"reasoning": {
"type": ["string", "null"]
}
},
"additionalProperties": false
}
