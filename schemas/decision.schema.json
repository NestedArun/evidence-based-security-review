{
"$schema": "https://json-schema.org/draft/2020-12/schema",
"title": "Decision",
"type": "object",
"required": [
"decision_id",
"finding_id",
"status",
"evidence_score",
"confidence",
"reason"
],
"properties": {
"decision_id": {
"type": "string"
},
"finding_id": {
"type": "string"
},
"status": {
"type": "string",
"enum": [
"VERIFIED",
"UNCERTAIN",
"REJECTED"
]
},
"evidence_score": {
"type": "number",
"minimum": 0,
"maximum": 100
},
"confidence": {
"type": "number",
"minimum": 0,
"maximum": 1
},
"reason": {
"type": "string"
},
"remediation": {
"type": ["string", "null"]
}
},
"additionalProperties": false
}
